# Set these environment variables in your terminal before starting Lumen.
# This file is a template; Lumen does not automatically load .env files.
LUMEN_VAULT=C:/path/to/your/ObsidianVault
ATLAS_ROOT=C:/path/to/atlas
LUMEN_NOTION_LIBRARY_ID=your-notion-data-source-id
LUMEN_NOTION_LIBRARY_URL=https://www.notion.so/your-library
# Optional HTTPS link or file:/// URL for your own dashboard:
LUMEN_SIDE_HUSTLE_URL=
